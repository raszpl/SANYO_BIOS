seg000:51E3 sub_F051E3      proc near               ; CODE XREF: sub_F04360+48↑p
seg000:51E3                 mov     ah, 0Fh
seg000:51E5                 int     10h             ; - VIDEO - GET CURRENT VIDEO MODE
seg000:51E5                                         ; Return: AH = number of columns on screen
seg000:51E5                                         ; AL = current video mode
seg000:51E5                                         ; BH = current active display page
seg000:51E7                 mov     ds:77h, al
seg000:51EA                 mov     ah, 3
seg000:51EC                 int     10h             ; - VIDEO - READ CURSOR POSITION
seg000:51EC                                         ; BH = page number
seg000:51EC                                         ; Return: DH,DL = row,column, CH = cursor start line, CL = cursor end line
seg000:51EE                 mov     ds:78h, cx
seg000:51F2                 mov     ah, 0
seg000:51F4                 mov     al, 3
seg000:51F6                 int     10h             ; - VIDEO - SET VIDEO MODE
seg000:51F6                                         ; AL = mode
seg000:51F8                 mov     ch, 20h ; ' '
seg000:51FA                 mov     ah, 1
seg000:51FC                 int     10h             ; - VIDEO - SET CURSOR CHARACTERISTICS
seg000:51FC                                         ; CH bits 0-4 = start line for cursor in character cell
seg000:51FC                                         ; bits 5-6 = blink attribute
seg000:51FC                                         ; CL bits 0-4 = end line for cursor in character cell
seg000:51FE                 retn
seg000:51FE sub_F051E3      endp
